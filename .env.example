PORT=3000
HOST=127.0.0.1

# token awal (ambil dari tab Response request login/refresh di DevTools)
VIKEY_ACCESS=
VIKEY_REFRESH=

# endpoint (refresh sudah dari screenshot lo, balance harus lo isi sendiri)
VIKEY_REFRESH_URL=https://app.vikey.ai/api/auth/refresh
VIKEY_BALANCE_URL=

# opsional: auto-login kalau refresh token mati
VIKEY_LOGIN_URL=
VIKEY_EMAIL=
VIKEY_PASSWORD=

# kunci rahasia buat web lo manggil /balance (isi bebas, panjang)
MY_API_KEY=
ALLOWED_ORIGIN=*
